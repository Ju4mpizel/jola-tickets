# Copiar a .env.local y completar. Nunca poner llaves secretas aquí.

# Base del contrato /api/v1 (Versión B: /api/v1 · Versión A: https://<backend>/api/v1)
NEXT_PUBLIC_API_URL=/api/v1

# true = responde con src/services/mocks.js mientras no exista el backend
NEXT_PUBLIC_USE_MOCKS=true

# Solo para el login de la directiva (llave anon, pública)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY y las llaves privadas de EmailJS NO van en el frontend.
