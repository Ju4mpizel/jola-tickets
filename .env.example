# Copiar a .env.local y completar. Este archivo NO lleva valores reales.
# En Vercel se cargan las mismas variables en Settings → Environment Variables.

# ---------- Públicas (llegan al navegador) ----------
# Base del contrato /api/v1 (Versión B: /api/v1 · Versión A: https://<backend>/api/v1)
NEXT_PUBLIC_API_URL=/api/v1
# true = responde con src/services/mocks.js mientras no exista el backend
NEXT_PUBLIC_USE_MOCKS=true
# Supabase: solo para el login de la directiva (llave publishable / anon)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Solo servidor (nunca con prefijo NEXT_PUBLIC_) ----------
# Dirección pública del sitio, sin barra final (ej. https://jola-tickets.vercel.app)
APP_URL=
# Llave secreta de Supabase (sb_secret_…): solo en src/server/
SUPABASE_SERVICE_ROLE_KEY=
# EmailJS: los correos se envían siempre desde el servidor
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_APPROVED=
EMAILJS_TEMPLATE_REJECTED=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
